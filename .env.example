# Korean electricity market price forecasting project
# Copy to `.env` and fill in real values.

# Public Data Portal (data.go.kr) service key for KPX APIs.
# Decoded form is preferred for the `requests` library.
KPX_PUBLIC_API_KEY=

# Optional: separate key if you use the encoded form somewhere.
KPX_PUBLIC_API_KEY_ENCODED=

# KMA (Korea Meteorological Administration) service key.
# data.go.kr issues the same key for ASOS and mid-term forecast services.
# `KMA_PUBLIC_API_KEY`         — raw (un-encoded) key; pass through requests params.
# `KMA_PUBLIC_API_KEY_ENCODED` — URL-encoded form; use when building URLs manually.
KMA_PUBLIC_API_KEY=
KMA_PUBLIC_API_KEY_ENCODED=

# Bank of Korea ECOS API key (for FX rates).
ECOS_API_KEY=

# EIA Open Data API key (https://www.eia.gov/opendata/register.php). Free.
# Used by src/collectors/eia_steo.py to pull STEO (Short-Term Energy
# Outlook) Brent/WTI/Henry Hub forecasts for the round-7+ LNG forecaster.
EIA_API_KEY=

# Storage backend: duckdb | postgres
STORAGE_BACKEND=duckdb

# DuckDB database file (relative to project root).
DUCKDB_PATH=data/kpx_forecast.duckdb

# Postgres connection (only used when STORAGE_BACKEND=postgres).
POSTGRES_DSN=postgresql://user:pass@localhost:5432/kpx_forecast

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Default timezone for all event/published timestamps.
PROJECT_TIMEZONE=Asia/Seoul

# ---------------------------------------------------------------------------
# MLflow + Postgres (MLOps stack — see docker-compose.yml)
# ---------------------------------------------------------------------------
#
# These are the defaults used by `docker compose up -d` and by the helpers
# in `src/tracking/mlflow_utils.py`. Override in `.env` if you change the
# bind ports or want to point at a remote MLflow server.

# Tracking server URI. When `docker compose up -d` is running, this is
# what training scripts use to log runs. Leave unset to disable MLflow
# logging entirely (passing `--log-to-mlflow` without this set will fail
# loud rather than silently dropping the run).
MLFLOW_TRACKING_URI=http://localhost:5000

# Experiment name. All runs from the smoke test land under this experiment;
# the dashboard MLOps page also keys off it.
MLFLOW_EXPERIMENT_NAME=kpx-smp-monthly

# When set to "true" (or "1"), training/walk-forward pipelines log to
# MLflow without needing the --log-to-mlflow CLI flag. Useful when running
# from inside the docker-compose project container.
ENABLE_MLFLOW=false

# Postgres backend for MLflow's metadata store. Values match the
# docker-compose service defaults — change all three together if you
# customise the compose file. DO NOT reuse production credentials here:
# this Postgres instance only stores MLflow run metadata and is intended
# for local dev only.
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow
POSTGRES_DB=mlflow
# Host MLflow uses to reach Postgres. Inside the compose network this is
# the service name (`postgres`); from the host it's localhost:5433 — port
# 5432 is left alone because a local Postgres often already uses it.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
