# Korean electricity market price forecasting project
# Copy to `.env` and fill in real values.

# Public Data Portal (data.go.kr) service key for KPX APIs.
# Decoded form is preferred for the `requests` library.
KPX_PUBLIC_API_KEY=

# Optional: separate key if you use the encoded form somewhere.
KPX_PUBLIC_API_KEY_ENCODED=

# KMA (Korea Meteorological Administration) service key.
# data.go.kr issues the same key for ASOS and mid-term forecast services.
# `KMA_PUBLIC_API_KEY`         — raw (un-encoded) key; pass through requests params.
# `KMA_PUBLIC_API_KEY_ENCODED` — URL-encoded form; use when building URLs manually.
KMA_PUBLIC_API_KEY=
KMA_PUBLIC_API_KEY_ENCODED=

# Bank of Korea ECOS API key (for FX rates).
ECOS_API_KEY=

# EIA Open Data API key (https://www.eia.gov/opendata/register.php). Free.
# Used by src/collectors/eia_steo.py to pull STEO (Short-Term Energy
# Outlook) Brent/WTI/Henry Hub forecasts for the round-7+ LNG forecaster.
EIA_API_KEY=

# Storage backend: duckdb | postgres
STORAGE_BACKEND=duckdb

# DuckDB database file (relative to project root).
DUCKDB_PATH=data/kpx_forecast.duckdb

# Postgres connection (only used when STORAGE_BACKEND=postgres).
POSTGRES_DSN=postgresql://user:pass@localhost:5432/kpx_forecast

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Default timezone for all event/published timestamps.
PROJECT_TIMEZONE=Asia/Seoul
