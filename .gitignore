.env
.env.*
!.env.example

# External sister projects dropped into this repo for integration reference.
# They carry their own .env (with API keys + DB credentials), their own .venv
# (~600 MB), and large input CSVs (~90 MB). They are NOT part of this repo's
# build/test surface — they are looked at by hand and documented in
# docs/external_models_inventory.md.
solar/
solar_beam/
additional_data/
additional_data_2/
additional_data_3/

# Reference documents (KMA API guides, energy-forecast pipeline PDFs)
# shared into the workspace for LLM context — not part of the repo.
/*.pdf
/*.docx
/*.xlsx

__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
