*.swp

# Streamlit local config is per-developer (LAN binding, CORS/XSRF
# toggles, theme overrides, etc.) — committing it would force every
# clone to inherit one developer's network-exposure choice. Ship the
# safe-defaults sample at .streamlit/config.toml.example instead.
.streamlit/config.toml

data/raw/**/*.json
data/raw/**/*.xml
data/raw/**/*.csv
data/raw/**/*.parquet
data/raw/**/*.xlsx
data/raw/**/*.xls
data/raw/**/*.zip
data/interim/**/*
data/processed/**/*
data/snapshots/**/*
!data/**/.gitkeep

outputs/models/**/*
outputs/metrics/**/*
outputs/figures/**/*
outputs/predictions/**/*
!outputs/**/.gitkeep

*.duckdb
*.duckdb.wal

# MLflow artifact root — bind-mounted by docker-compose, holds pickled
# models + predictions per run. Can grow large; keep out of git.
artifacts/mlflow/
